#!/usr/bin/env python3
"""Check tracked working-tree bytes and names without exposing matched values."""
import argparse
from collections import deque
import os
import posixpath
from pathlib import Path
import re
import subprocess
import sys

GENERIC = {
    'absolute machine path': r'/(?:home/[^/\s]+|Users/[^/\s]+|mnt/[^\s]+|workspace/[^\s]+)',
    'email': r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b',
    'hostname': r'(?<![\w.-])[a-zA-Z0-9][a-zA-Z0-9.-]*\.(?:ts\.net|local|internal|lan|home\.arpa|corp)(?![\w.-])',
    'IP address': r'\b(?!(?:127\.0\.0\.1|0\.0\.0\.0)\b)(?:\d{1,3}\.){3}\d{1,3}\b',
    'token': r'\b(?:sk-(?:proj-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{15,}|AKIA[A-Z0-9]{16})\b',
    'private key': r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',
    'credential assignment': r'(?i)(?:api[_-]?key|access[_-]?token|password|secret)\s*[=:]\s*[\"\'][A-Za-z0-9_+/=-]{20,}[\"\']',
    'private skill name': r'\bprivate-[a-z0-9]+(?:-[a-z0-9]+)*\b',
}


def load_patterns(root):
    patterns = [(kind, re.compile(pattern)) for kind, pattern in GENERIC.items()]
    local = root / '.public-safe-patterns.local'
    # This file contains literal identifiers, one per line, never regex code.
    if local.is_file():
        for line in local.read_text().splitlines():
            value = line.strip()
            if value and not value.startswith('#'):
                patterns.append(('local private identifier', re.compile(r'(?<![\w-])' + re.escape(value) + r'(?![\w-])', re.I)))
    return patterns


def check(root, patterns):
    result = subprocess.run(['git', '-C', str(root), 'ls-files', '-z'],
                            capture_output=True, check=True)
    names = result.stdout.decode('utf-8', errors='strict').split('\0')
    local = root / '.public-safe-patterns.local'
    findings = []
    count = 0
    for name in names:
        if not name:
            continue
        if name == local.name:
            findings.append((name, 0, 'local patterns file is tracked'))
            continue
        path = root / name
        # Never follow a symlinked parent while scanning tracked files.
        if any(parent.is_symlink() for parent in path.parents if parent != root and parent.is_relative_to(root)):
            findings.append((name, 0, 'symlinked parent'))
            continue
        count += 1
        if path.is_symlink():
            content = str(path.readlink())
            if Path(content).is_absolute() or not (path.parent / content).resolve().is_relative_to(root):
                findings.append((name, 0, 'symlink target outside repository'))
        elif path.is_file():
            content = path.read_bytes().decode('utf-8', errors='replace')
        else:
            findings.append((name, 0, 'tracked file missing or unsupported'))
            continue
        for kind, pattern in patterns:
            if pattern.search(name):
                findings.append((name, 0, kind + ' in filename'))
            for match in pattern.finditer(content):
                findings.append((name, content.count('\n', 0, match.start()) + 1, kind))
    for name, line, kind in findings:
        # Redact filenames too if their names triggered a privacy detector.
        label = '<redacted filename>' if any(p.search(name) for _, p in patterns) else name
        print(f'FAIL {label}:{line}: {kind}')
    if findings:
        print(f'check-public-safe: FAIL ({len(findings)} findings in {count} tracked files)')
        return 1
    print(f'check-public-safe: PASS ({count} tracked files)')
    return 0


# Limits apply before reading each object and across the complete history scan.
MAX_OBJECT_BYTES = 16 * 1024 * 1024
MAX_HISTORY_BYTES = 512 * 1024 * 1024
MAX_HISTORY_ENTRIES = 1000000


def check_history(root, refs, patterns):
    env = os.environ.copy()
    env['GIT_NO_REPLACE_OBJECTS'] = '1'
    env['GIT_NO_LAZY_FETCH'] = '1'

    def git(*args, input_bytes=None):
        return subprocess.run(['git', '-C', str(root), *args], env=env,
                              input=input_bytes, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, check=True).stdout

    if git('rev-parse', '--is-shallow-repository').strip() != b'false':
        raise ValueError('shallow repository')

    pending = []
    for ref in refs:
        # Do not accept revision expressions or options in place of exact refs.
        if not ref or ref.startswith('-') or any(c in ref for c in '^~:') or '@{' in ref:
            raise ValueError('invalid ref')
        if ref != 'HEAD' and not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', ref):
            symbolic = git('rev-parse', '--symbolic-full-name', '--verify',
                           '--end-of-options', ref).strip()
            if not symbolic.startswith(b'refs/') or b'\n' in symbolic:
                raise ValueError('ambiguous or invalid ref')
        oid = git('rev-parse', '--verify', '--end-of-options', ref).strip()
        if not re.fullmatch(rb'[0-9a-f]{40}|[0-9a-f]{64}', oid):
            raise ValueError('invalid object id')
        pending.append((oid.decode('ascii'), 'root', '', ''))

    cache = {}
    expanded = set()
    findings = []
    total_bytes = 0
    entries = 0
    scheduled = len(pending)

    def charge(size):
        nonlocal total_bytes
        if total_bytes + size > MAX_HISTORY_BYTES:
            raise ValueError('history memory limit')
        total_bytes += size

    def schedule(oid, expected, path, tree_root):
        nonlocal scheduled
        scheduled += 1
        if scheduled > MAX_HISTORY_ENTRIES:
            raise ValueError('history entry limit')
        charge(sys.getsizeof(path) + 256)
        pending.append((oid, expected, path, tree_root))

    def object_data(oid):
        nonlocal total_bytes
        if oid in cache:
            return cache[oid]
        info = git('cat-file', '--batch-check=%(objectname) %(objecttype) %(objectsize)',
                   input_bytes=oid.encode('ascii') + b'\n')
        parts = info.strip().split()
        if len(parts) != 3 or parts[0] != oid.encode('ascii'):
            raise ValueError('missing or invalid object')
        kind = parts[1].decode('ascii')
        size = int(parts[2])
        if size < 0 or size > MAX_OBJECT_BYTES or total_bytes + size > MAX_HISTORY_BYTES:
            raise ValueError('history object limit')
        if kind not in ('commit', 'tree', 'blob', 'tag'):
            raise ValueError('unsupported object')
        with subprocess.Popen(['git', '-C', str(root), 'cat-file', kind, oid],
                              env=env, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL) as process:
            data = process.stdout.read(size + 1)
            if len(data) > size:
                process.kill()
            status = process.wait()
        if status:
            raise ValueError('unreadable object')
        if len(data) != size:
            raise ValueError('incomplete object')
        total_bytes += size
        cache[oid] = (kind, data)
        return kind, data

    def tree_entries(oid):
        kind, data = object_data(oid)
        if kind != 'tree':
            raise ValueError('invalid tree')
        offset = 0
        oid_bytes = len(oid) // 2
        while offset < len(data):
            space = data.find(b' ', offset)
            nul = data.find(b'\0', space + 1) if space >= 0 else -1
            if space < 0 or nul < 0 or nul + 1 + oid_bytes > len(data):
                raise ValueError('invalid tree')
            mode = data[offset:space]
            name = data[space + 1:nul]
            if not name or b'/' in name or name in (b'.', b'..'):
                raise ValueError('invalid tree name')
            yield mode, name.decode('utf-8', errors='surrogateescape'), data[nul + 1:nul + 1 + oid_bytes].hex()
            offset = nul + 1 + oid_bytes

    def symlink_escapes(tree_root, path):
        resolved = []
        remaining = deque()
        followed = 0

        def prepend(value):
            charge(sys.getsizeof(value) + 64 * (value.count('/') + 1))
            remaining.extendleft(reversed(value.split('/')))

        prepend(path)
        while remaining:
            part = remaining.popleft()
            if part in ('', '.'):
                continue
            if part == '..':
                if not resolved:
                    return True
                resolved.pop()
                continue
            directory = resolved[-1][1] if resolved else tree_root
            entry = next((item for item in tree_entries(directory) if item[1] == part), None) if directory else None
            if entry and entry[0] == b'120000':
                followed += 1
                if followed > 40:
                    raise ValueError('unresolvable symlink chain')
                kind, target = object_data(entry[2])
                if kind != 'blob' or not target or b'\0' in target:
                    raise ValueError('invalid symlink')
                target_text = target.decode('utf-8', errors='surrogateescape')
                if posixpath.isabs(target_text):
                    return True
                prepend(target_text)
            else:
                child_tree = entry[2] if entry and entry[0] in (b'40000', b'040000') else None
                resolved.append((part, child_tree))
        return False

    def scan(oid, location, value):
        for category, pattern in patterns:
            line = 1
            previous = 0
            for match in pattern.finditer(value):
                if len(findings) >= MAX_HISTORY_ENTRIES:
                    raise ValueError('history finding limit')
                line += value.count('\n', previous, match.start())
                previous = match.start()
                findings.append((oid, location, line, category))

    while pending:
        oid, expected, path, tree_root = pending.pop()
        entries += 1
        if entries > MAX_HISTORY_ENTRIES:
            raise ValueError('history entry limit')
        kind, data = object_data(oid)
        if expected == 'root':
            if kind not in ('commit', 'tag'):
                raise ValueError('unsupported history target')
        elif expected != kind:
            raise ValueError('object type mismatch')

        # Paths must be checked for each tree occurrence, even when its object
        # was seen elsewhere. Other object contents can be checked once.
        key = (oid, path, tree_root) if kind == 'tree' else (oid, '')
        if key in expanded:
            continue
        expanded.add(key)
        if kind == 'tree':
            for mode, name, child_oid in tree_entries(oid):
                child_path = posixpath.join(path, name)
                scan(oid, 'path', child_path)
                if child_path == '.public-safe-patterns.local':
                    findings.append((oid, 'path', 0, 'local patterns file is tracked'))
                if mode in (b'40000', b'040000'):
                    child_kind = 'tree'
                elif mode in (b'100644', b'100755', b'120000'):
                    child_kind = 'blob'
                else:
                    raise ValueError('unsupported tree entry')
                schedule(child_oid, child_kind, child_path, tree_root)
                if mode == b'120000' and symlink_escapes(tree_root, child_path):
                    findings.append((child_oid, 'symlink', 0, 'symlink target outside repository'))
        elif kind == 'blob':
            scan(oid, 'content', data.decode('utf-8', errors='replace'))
        else:
            scan(oid, 'metadata', data.decode('utf-8', errors='replace'))
            header, separator, _ = data.partition(b'\n\n')
            if not separator:
                raise ValueError('invalid object metadata')
            fields = header.split(b'\n')
            if kind == 'commit':
                trees = [line[5:] for line in fields if line.startswith(b'tree ')]
                parents = [line[7:] for line in fields if line.startswith(b'parent ')]
                if len(trees) != 1:
                    raise ValueError('invalid commit')
                links = [(trees[0], 'tree')] + [(parent, 'commit') for parent in parents]
            else:
                objects = [line[7:] for line in fields if line.startswith(b'object ')]
                types = [line[5:] for line in fields if line.startswith(b'type ')]
                if len(objects) != 1 or len(types) != 1 or types[0] not in (b'commit', b'tag'):
                    raise ValueError('unsupported tag target')
                links = [(objects[0], types[0].decode('ascii'))]
            for linked, linked_kind in links:
                if not re.fullmatch(rb'[0-9a-f]{' + str(len(oid)).encode() + rb'}', linked):
                    raise ValueError('invalid object link')
                linked_oid = linked.decode('ascii')
                schedule(linked_oid, linked_kind, '', linked_oid if linked_kind == 'tree' else '')

    for oid, location, line, category in findings:
        print(f'FAIL object {oid} {location}:{line}: {category}')
    if findings:
        print(f'check-public-safe: FAIL ({len(findings)} history findings)')
        return 1
    print(f'check-public-safe: PASS ({len(cache)} history objects)')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument('--history', action='append', default=[], metavar='REF',
                        help='also check all objects reachable from this commit or tag ref')
    args = parser.parse_args()
    try:
        root = args.root.resolve()
        patterns = load_patterns(root)
        tree_result = check(root, patterns)
        history_result = check_history(root, args.history, patterns) if args.history else 0
        return max(tree_result, history_result)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f'check-public-safe: ERROR ({type(error).__name__})', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
