#!/usr/bin/env python3
"""Check tracked working-tree bytes and names without exposing matched values."""
import argparse
from pathlib import Path
import re
import subprocess
import sys

GENERIC = {
    'absolute machine path': r'/(?:home/[^/\s]+|Users/[^/\s]+|mnt/[^\s]+|workspace/[^\s]+)',
    'email': r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b',
    'hostname': r'(?<![\w.-])[a-zA-Z0-9][a-zA-Z0-9.-]*\.(?:ts\.net|local|internal|lan|home\.arpa|corp)(?![\w.-])',
    'IP address': r'\b(?!(?:127\.0\.0\.1|0\.0\.0\.0)\b)(?:\d{1,3}\.){3}\d{1,3}\b',
    'token': r'\b(?:sk-(?:proj-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{15,}|AKIA[A-Z0-9]{16})\b',
    'private key': r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',
    'credential assignment': r'(?i)(?:api[_-]?key|access[_-]?token|password|secret)\s*[=:]\s*[\"\'][A-Za-z0-9_+/=-]{20,}[\"\']',
    'private skill name': r'\bprivate-[a-z0-9]+(?:-[a-z0-9]+)*\b',
}


def check(root):
    result = subprocess.run(['git', '-C', str(root), 'ls-files', '-z'],
                            capture_output=True, check=True)
    names = result.stdout.decode('utf-8', errors='strict').split('\0')
    patterns = [(kind, re.compile(pattern)) for kind, pattern in GENERIC.items()]
    local = root / '.public-safe-patterns.local'
    # This file contains literal identifiers, one per line, never regex code.
    if local.is_file():
        for line in local.read_text().splitlines():
            value = line.strip()
            if value and not value.startswith('#'):
                patterns.append(('local private identifier', re.compile(r'(?<![\w-])' + re.escape(value) + r'(?![\w-])', re.I)))
    findings = []
    count = 0
    for name in names:
        if not name:
            continue
        if name == local.name:
            findings.append((name, 0, 'local patterns file is tracked'))
            continue
        path = root / name
        # Never follow a symlinked parent while scanning tracked files.
        if any(parent.is_symlink() for parent in path.parents if parent != root and parent.is_relative_to(root)):
            findings.append((name, 0, 'symlinked parent'))
            continue
        count += 1
        if path.is_symlink():
            content = str(path.readlink())
            if Path(content).is_absolute() or not (path.parent / content).resolve().is_relative_to(root):
                findings.append((name, 0, 'symlink target outside repository'))
        elif path.is_file():
            content = path.read_bytes().decode('utf-8', errors='replace')
        else:
            findings.append((name, 0, 'tracked file missing or unsupported'))
            continue
        for kind, pattern in patterns:
            if pattern.search(name):
                findings.append((name, 0, kind + ' in filename'))
            for match in pattern.finditer(content):
                findings.append((name, content.count('\n', 0, match.start()) + 1, kind))
    for name, line, kind in findings:
        # Redact filenames too if their names triggered a privacy detector.
        label = '<redacted filename>' if any(p.search(name) for _, p in patterns) else name
        print(f'FAIL {label}:{line}: {kind}')
    if findings:
        print(f'check-public-safe: FAIL ({len(findings)} findings in {count} tracked files)')
        return 1
    print(f'check-public-safe: PASS ({count} tracked files)')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[1])
    args = parser.parse_args()
    try:
        return check(args.root.resolve())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f'check-public-safe: ERROR ({type(error).__name__})', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
